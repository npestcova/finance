{
    "name": "buu/finance",
    "description": "my finance",
    "type": "project",
    "license": "BSD-3-Clause",
    "keywords": [
        "finance"
    ],
    "homepage": "http://finance.local/",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-gd": "*",
        "ext-intl": "*",
        "laminas/laminas-component-installer": "*",
        "laminas/laminas-mvc": "^3.7.0",
        "laminas/laminas-development-mode": "*",
        "laminas/laminas-mvc-form": "*",
        "laminas/laminas-mvc-plugins": "*",
        "laminas/laminas-session": "*",
        "laminas/laminas-authentication": "*",
        "doctrine/doctrine-orm-module": "*",
        "doctrine/migrations": "*",
        "laminas/laminas-math": "*",
        "laminas/laminas-json": "*",
        "laminas/laminas-crypt": "*",
        "laminas/laminas-captcha": "*",
        "laminas/laminas-mail": "*",
        "laminas/laminas-mime": "*"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/",
            "User\\": "module/User/src/",
            "Finance\\": "library/Finance/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ApplicationTest\\": "module/Application/test/",
            "UserTest\\": "module/User/test/"
        }
    },
    "extra": [],
    "scripts": {
        "cs-check": "phpcs",
        "cs-fix": "phpcbf",
        "development-disable": "laminas-development-mode disable",
        "development-enable": "laminas-development-mode enable",
        "development-status": "laminas-development-mode status",
        "post-create-project-cmd": [
            "@development-enable"
        ],
        "serve": "php -S 0.0.0.0:8080 -t public public/index.php",
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        }
    }
}
